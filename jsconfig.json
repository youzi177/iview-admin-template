{
  "compilerOptions": {
    "target": "es2017",
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "_c/*": ["src/components/*"],
      "~/*": ["node_modules/*"]
    },
    "checkJs": false
  },
  "include": ["src/**/*.js", "src/**/*.jsx", "src/**/*.vue"],
  "exclude": ["node_modules", "dist"]
}
